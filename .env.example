# =============================================================================
# Multi-Agent Coding Assistant Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Choose your LLM provider: anthropic, openai, or ollama
LLM_PROVIDER=anthropic

# Model name (leave empty for provider default)
# Anthropic: claude-sonnet-4-20250514, claude-opus-4-20250514
# OpenAI: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# Ollama: llama3, mistral, codellama
MODEL_NAME=

# =============================================================================
# API Keys (based on your LLM_PROVIDER choice)
# =============================================================================
# Anthropic (required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# OpenAI (required if LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=

# Ollama (required if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# Embedding Configuration
# =============================================================================
# Choose your embedding provider: huggingface, openai, or ollama
# huggingface: Free, runs locally (recommended for most users)
# openai: Requires API key, better quality for some use cases
# ollama: Local, requires Ollama server with embedding model
EMBEDDING_PROVIDER=huggingface

# Embedding model (leave empty for provider default)
# HuggingFace: sentence-transformers/all-MiniLM-L6-v2
# OpenAI: text-embedding-3-small, text-embedding-3-large
# Ollama: nomic-embed-text, mxbai-embed-large
EMBEDDING_MODEL=

# =============================================================================
# Performance Tuning
# =============================================================================
# Chunk size for code splitting (characters)
CHUNK_SIZE=1500

# Overlap between chunks (characters)
CHUNK_OVERLAP=200

# Maximum tokens in LLM response
MAX_TOKENS=4096

# Maximum search results to return
MAX_RESULTS=5

# Maximum agent iterations per request
MAX_ITERATIONS=5

# =============================================================================
# Storage Configuration
# =============================================================================
# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./.chroma_db

# =============================================================================
# Permission Mode
# =============================================================================
# Controls what agents can do:
# full: Agents can read, write, and execute
# readonly: Agents can only read and suggest
# ask: Prompt before any modifications (recommended)
PERMISSION_MODE=ask
